DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Channel IDs. Names match the live Discord channels.
# Required: #members, #wars, #cwl, #capital, #clan-games
# Optional: #donations
DISCORD_MEMBERS_CHANNEL_ID=
DISCORD_WARS_CHANNEL_ID=
DISCORD_CWL_CHANNEL_ID=
DISCORD_CAPITAL_CHANNEL_ID=
DISCORD_CLAN_GAMES_CHANNEL_ID=
DISCORD_DONATIONS_CHANNEL_ID=
DISCORD_REPORT_CHANNEL_ID=
REPORT_TIMEZONE=America/Toronto

# Optional. Only set this to point the client at a local stub instead of Discord.
# DISCORD_API_BASE_URL=https://discord.com/api

# Identity only. Current clan roster (tag + name) fills display names that
# Discord tag-bearing logs did not resolve. Metrics still come from ClashPerk.
# Leave both unset to run Discord-only attribution.
COC_API_TOKEN=
COC_CLAN_TAG=
# Optional. Override to point the client at a local stub.
# COC_API_BASE_URL=https://api.clashofclans.com/v1
